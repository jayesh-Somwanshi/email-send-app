# Copy this file to .env and add your Google OAuth credentials.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000

# Create these in Google Cloud Console > APIs & Services > Credentials.
# Authorized redirect URI:
# http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://email-send-app-two.vercel.app/auth/google/callback

# Gmail API send-only permission is used by the app.
